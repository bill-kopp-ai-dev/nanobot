FROM python:3.12-slim-trixie@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

ARG VERSION=0.1.0
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="Percival MCP Broker" \
      org.opencontainers.image.description="Docker daemon broker for Percival-managed MCP containers" \
      org.opencontainers.image.source="https://github.com/bill-kopp-ai-dev/nanobot" \
      org.opencontainers.image.documentation="https://github.com/bill-kopp-ai-dev/nanobot/blob/main/docs/deployment.md" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="Positronic Bean Labs" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}"

COPY docker/mcp-broker-requirements.lock /tmp/mcp-broker-requirements.lock
RUN python3 -c 'import hashlib, urllib.request; url="https://download.docker.com/linux/debian/dists/trixie/pool/stable/amd64/docker-ce-cli_29.9.2-1~debian.13~trixie_amd64.deb"; data=urllib.request.urlopen(url).read(); expected="6a266cb8acafa475e87ce2414387707024b55fb169d6ca1fb6c3132f234d4cf1"; actual=hashlib.sha256(data).hexdigest(); assert actual == expected, f"docker-ce-cli sha256 mismatch: {actual}"; open("/tmp/docker-ce-cli.deb", "wb").write(data)' && \
    dpkg -i /tmp/docker-ce-cli.deb && \
    rm /tmp/docker-ce-cli.deb
RUN python3 -m venv /opt/broker-venv && \
    /opt/broker-venv/bin/pip install --no-cache-dir --require-hashes --no-deps \
      -r /tmp/mcp-broker-requirements.lock && \
    rm -rf /usr/local/bin/pip* \
           /usr/local/lib/python3.12/site-packages/pip \
           /usr/local/lib/python3.12/site-packages/pip-*.dist-info \
           /usr/local/lib/python3.12/ensurepip/_bundled \
           /opt/broker-venv/bin/pip* \
           /opt/broker-venv/lib/python3.12/site-packages/pip \
           /opt/broker-venv/lib/python3.12/site-packages/pip-*.dist-info \
           /tmp/mcp-broker-requirements.lock

WORKDIR /app
COPY nanobot/__init__.py nanobot/config_base.py nanobot/
COPY nanobot/mcp_docker/__init__.py nanobot/mcp_docker/contracts.py \
     nanobot/mcp_docker/acquisition_policy.py nanobot/mcp_docker/mount_policy.py \
     nanobot/mcp_docker/broker.py \
     nanobot/mcp_docker/probe.py nanobot/mcp_docker/
RUN chmod -R a+rX /app/nanobot

ENV PATH="/opt/broker-venv/bin:$PATH" PYTHONUNBUFFERED=1
USER 65532:65532
STOPSIGNAL SIGTERM
ENTRYPOINT ["python3", "-m", "nanobot.mcp_docker.broker"]
